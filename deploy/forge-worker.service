[Unit]
Description=Bake Forge host worker
After=network.target

[Service]
Type=simple
# Template: replace the repo prefix below if using a different checkout.
# Environment= values are literal; systemd does not expand shell variables here.
WorkingDirectory=/home/alexk/documents/open_sprite_pipeline/open_sprite_pipeline
Environment=FORGE_API=http://127.0.0.1:8050
Environment=FORGE_STORE_ROOT=/home/alexk/documents/open_sprite_pipeline/open_sprite_pipeline/.runs/trellis2-container/ui/forge
Environment=FORGE_SPIKE_ASSETS=/home/alexk/debt-city-greybox-spike/apps/greybox/assets
Environment=FORGE_BAKE_PYTHON=/home/alexk/.venv/bin/python
Environment=FORGE_CRITIC_URL=http://127.0.0.1:18001/v1
Environment=FORGE_CRITIC_MODEL=Qwen/Qwen3.5-4B
Environment=FORGE_CRITIC_ENABLED=1
Environment=FORGE_ONCE=0
Environment=FORGE_POLL_INTERVAL=2
Environment=PYTHONUNBUFFERED=1
# Set only when the identical token is configured in the container.
# Environment=FORGE_WORKER_TOKEN=replace-locally
ExecStart=/home/alexk/documents/open_sprite_pipeline/open_sprite_pipeline/.venv/bin/python -m open_sprite_pipeline.forge_worker
Restart=on-failure
RestartSec=5
# Allow the worker time to terminate Blender and restore staged spike inputs.
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=default.target
